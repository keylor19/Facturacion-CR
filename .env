# Ambiente: "stag" (pruebas de Hacienda) o "prod" (producción real)
AMBIENTE=stag

DATABASE_URL=postgresql+psycopg2://facturacion:facturacion@db:5432/facturacion
REDIS_URL=redis://redis:6379/0

# Credenciales OIDC que Hacienda envía a tu buzón electrónico tras activar
# comprobantes electrónicos en ATV
HACIENDA_USERNAME=cpj-02-3101123456@comprobanteselectronicos.go.cr
HACIENDA_PASSWORD=

# Certificado digital
CERT_P12_PATH=/app/certs/certificado.p12
CERT_P12_PASSWORD=

# Datos del emisor (tu empresa)
EMISOR_TIPO_IDENTIFICACION=02
EMISOR_NUMERO_IDENTIFICACION=3101123456
EMISOR_NOMBRE=Mi Empresa S.A.
EMISOR_PROVINCIA=1
EMISOR_CANTON=01
EMISOR_DISTRITO=01

# URL pública HTTPS donde Hacienda te notificará (debe ser accesible desde internet)
CALLBACK_BASE_URL=https://tu-dominio.com

JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
