      "parameters": {
        "jsCode": "const r = $json;\nconst ok = r.statusCode === 200 || r.statusCode === 202;\nconst detalle = r.body?.detail;\nreturn [{ json: {\n  ok,\n  status: r.statusCode,\n  factura_id: ok ? r.body.factura_id : null,\n  clave: ok ? r.body.clave : null,\n  estado: ok ? r.body.estado : null,\n  documentos_disponibles: r.headers?.['x-documentos-disponibles'] ?? null,\n  error: ok ? null : (typeof detalle === 'string' ? detalle : JSON.stringify(detalle)),\n} }];"
      },
