# Ambiente de la aplicación: "stag" (pruebas) o "prod" (producción).
# Cada emisor tiene además su propio ambiente de Hacienda (se configura por API).
AMBIENTE=stag

# Base de datos (POSTGRES_PASSWORD la usa docker-compose; debe coincidir con DATABASE_URL)
POSTGRES_PASSWORD=cambia-esta-contrasena
DATABASE_URL=postgresql+psycopg2://facturacion:cambia-esta-contrasena@db:5432/facturacion
REDIS_URL=redis://redis:6379/0

# Llave para cifrar certificados y contraseñas de los emisores.
# Generar con: docker compose run --rm --no-deps api python -m api.cli generar-master-key
# ⚠️ Respáldela: si se pierde, hay que volver a cargar certificados y contraseñas.
MASTER_KEY=

# API keys de ADMINISTRADOR de arranque, separadas por coma (32+ caracteres).
# Las demás llaves se crean por API (POST /api/v1/api-keys) o con la CLI.
API_KEYS=

# URL pública HTTPS donde Hacienda notificará (debe ser accesible desde internet)
CALLBACK_BASE_URL=https://tu-dominio.com
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_TOKEN=

# Carpeta con los XSD v4.4 oficiales (ATV -> Anexos y Estructuras). Muy recomendado.
XSD_DIR=/app/xsd

# Correo saliente para enviar los comprobantes a los clientes (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Orígenes permitidos para CORS (solo si un frontend web llama directo a la API)
CORS_ORIGINS=

# Política de firma (verificar con la resolución vigente). Si FIRMA_POLICY_DIGEST
# queda vacío se calcula descargando el documento de la política.
# FIRMA_POLICY_URL=
# FIRMA_POLICY_DIGEST=

# Panel web
SESION_HORAS=8
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

# Antigüedad máxima (días) de un comprobante en contingencia / sin internet
DIAS_MAX_CONTINGENCIA=30

# Venta por consumo: cada documento firmado y enviado descuenta 1 del saldo de la empresa
CONTROL_SALDO=true
SALDO_ALERTA_DOCUMENTOS=20
DIAS_ALERTA_VENCIMIENTO_PAQUETE=7

# Alquiler mensual de los servicios (API / facturación en línea), aparte de los documentos
CONTROL_SUSCRIPCIONES=true
DIAS_GRACIA_SUSCRIPCION=3
DIAS_ALERTA_SUSCRIPCION=7

# Datos públicos de Hacienda guardados en la base de datos: se actualizan cada N días
# (tarea diaria) y permiten seguir trabajando si Hacienda no responde
DIAS_ACTUALIZAR_HACIENDA=15
LOTE_ACTUALIZACION_HACIENDA=500
# Catálogo CABYS oficial (Excel del BCCR): se importa solo; cámbielo cuando publiquen una versión nueva
CABYS_URL=https://www.bccr.fi.cr/content/dam/bccr/noticias/2025/2025-04-01-catalogo-de-bienes-servicios-1.xlsx

# Límites de uso
LIMITE_SOLICITUDES_MINUTO=300
LIMITE_LOGIN_MINUTO=20
LIMITE_FALLOS_AUTH_MINUTO=30

# Verificación en dos pasos obligatoria para administradores del panel
# (vacío = obligatoria en producción, opcional en pruebas)
EXIGIR_2FA_ADMIN=

# Publicar /docs (OpenAPI) en producción para los integradores
DOCS_PUBLICAS=false

# --- Producción (docker-compose.prod.yml) ---
# Dominio público del servicio; Caddy obtiene el certificado HTTPS automáticamente
DOMINIO=api.tu-dominio.cr
# Días que se conservan los respaldos diarios de la base de datos (carpeta respaldos/)
DIAS_RETENCION_RESPALDO=14
